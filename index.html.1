<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="theme-color"
    content="#030711"
  >

  <title>MTC196 | Official</title>

  <link
    rel="stylesheet"
    href="style.css"
  >
</head>

<body>

  <!-- BACKGROUND -->
  <div class="background">
    <div class="orb orange-orb"></div>
    <div class="orb blue-orb"></div>
  </div>


  <!-- HEADER -->
  <header class="header">

    <div class="header-inner">

      <a
        href="#home"
        class="brand"
      >

        <img
          src="logo.png"
          alt="MTC196"
          class="header-logo"
        >

        <div class="brand-text">

          <strong>
            MTC<span>196</span>
          </strong>

          <small>
            OFFICIAL
          </small>

        </div>

      </a>


      <div class="online">

        <span class="online-dot"></span>

        <div>

          <small>
            STATUS
          </small>

          <strong>
            24/7 ONLINE
          </strong>

        </div>

      </div>

    </div>

  </header>


  <main>


    <!-- WELCOME -->
    <section
      class="welcome"
      id="home"
    >

      <div class="welcome-light"></div>


      <div class="official-badge">

        <span></span>

        MTC196 OFFICIAL

      </div>


      <p class="welcome-label">
        WELCOME TO
      </p>


      <h1>
        MTC<span>196</span>
      </h1>


      <p class="official-cs">
        OFFICIAL CUSTOMER SERVICE
      </p>


      <p class="welcome-description">
        Selamat datang ke MTC196.
        Ikuti channel rasmi kami untuk promosi,
        info terkini dan kemas kini terbaru.
      </p>


      <div class="welcome-line">

        <span></span>

        <div class="diamond"></div>

        <span></span>

      </div>

    </section>


    <!-- PROMOTION -->
    <section class="section promotion-section">

      <div class="section-title">

  <small>
    MTC196 REWARDS
  </small>

  <h2>
    Promotions
  </h2>

  <p>
    Enjoy exclusive promotions specially for new MTC196 members.
  </p>

      </div>


      <div class="promo-layout">


        <!-- WELCOME BONUS -->
        <div class="promo-row promo-row-one">

          <article class="promo-box">

            <div class="promo-icon">
              🧧
            </div>

            <div class="promo-text">

              <small>
                WELCOME BONUS
              </small>

              <strong>
                Welcome Bonus
              </strong>

            </div>

            <div class="promo-value">
              30%
            </div>

          </article>

        </div>


        <!-- ROW 2 -->
        <div class="promo-row">


          <article class="promo-box">

            <div class="promo-icon">
              🧧
            </div>

            <div class="promo-text">

              <small>
                REKEMEN BONUS
              </small>

              <strong>
                Rekemen Bonus
              </strong>

            </div>

            <div class="promo-value">
              20%
            </div>

          </article>


          <article class="promo-box">

            <div class="promo-icon">
              🧧
            </div>

            <div class="promo-text">

              <small>
                DAILY BONUS
              </small>

              <strong>
                1st Deposit
              </strong>

            </div>

            <div class="promo-value">
              20%
            </div>

          </article>


        </div>


        <!-- ROW 3 -->
        <div class="promo-row">


          <article class="promo-box">

            <div class="promo-icon">
              🧧
            </div>

            <div class="promo-text">

              <small>
                UNLIMITED
              </small>

              <strong>
                Deposit Bonus
              </strong>

            </div>

            <div class="promo-value">
              10%
            </div>

          </article>


          <article class="promo-box">

            <div class="promo-icon">
              🧧
            </div>

            <div class="promo-text">

              <small>
                DAILY REBATE
              </small>

              <strong>
                Daily Rebate
              </strong>

            </div>

            <div class="promo-badge daily">
              DAILY
            </div>

          </article>


        </div>


        <!-- WEEKLY REBATE -->
        <div class="promo-row promo-row-one">

          <article class="promo-box weekly-box">

            <div class="promo-icon">
              🧧
            </div>

            <div class="promo-text">

              <small>
                WEEKLY REBATE
              </small>

              <strong>
                Weekly Rebate
              </strong>

            </div>

            <div class="promo-badge wednesday">
              RABU
            </div>

          </article>

        </div>


      </div>

    </section>


    <!-- GROUP CHANNEL -->
    <section class="section channel-section">

      <div class="section-title">

        <small>
          OFFICIAL COMMUNITY
        </small>

        <h2>
          Group Channel
        </h2>

        <p>
          Ikuti channel rasmi MTC196 untuk info terbaru.
        </p>

      </div>


      <div class="channel-grid">


        <!-- WHATSAPP -->
        <a
          href="https://wa.link/tums26"
          class="channel-card whatsapp-card"
          target="_blank"
          rel="noopener noreferrer"
        >

          <div class="channel-icon">
            W
          </div>

          <div class="channel-text">

            <small>
              OFFICIAL CHANNEL
            </small>

            <strong>
              WhatsApp
            </strong>

            <span>
              Join MTC196
            </span>

          </div>

          <div class="channel-arrow">
            ›
          </div>

        </a>


        <!-- TELEGRAM -->
        <a
          href="https://t.me/mtc196c"
          class="channel-card telegram-card"
          target="_blank"
          rel="noopener noreferrer"
        >

          <div class="channel-icon">
            T
          </div>

          <div class="channel-text">

            <small>
              OFFICIAL CHANNEL
            </small>

            <strong>
              Telegram
            </strong>

            <span>
              Join MTC196
            </span>

          </div>

          <div class="channel-arrow">
            ›
          </div>

        </a>


      </div>

    </section>


    <!-- GAME LIST -->
    <section class="section game-section">

      <div class="section-title">

        <small>
          GAME PROVIDER
        </small>

        <h2>
          Game List
        </h2>

        <p>
          Pilih game kegemaran anda.
        </p>

      </div>


      <div class="game-grid">


        <!-- MEGA888 -->
        <button
          class="game-card"
          data-game="MEGA888"
          type="button"
        >

          <div class="game-logo-auto orange">

            <span class="default-logo">
              M
            </span>

            <img
              src="images/mega888.png"
              alt="MEGA888"
              class="real-game-logo"
            >

          </div>

          <strong>
            MEGA888
          </strong>

          <small>
            VIEW GAME
          </small>

        </button>


        <!-- PUSSY888 -->
        <button
          class="game-card"
          data-game="PUSSY888"
          type="button"
        >

          <div class="game-logo-auto blue">

            <span class="default-logo">
              P
            </span>

            <img
              src="images/pussy888.png"
              alt="PUSSY888"
              class="real-game-logo"
            >

          </div>

          <strong>
            PUSSY888
          </strong>

          <small>
            VIEW GAME
          </small>

        </button>


        <!-- 918KISSORI -->
        <button
          class="game-card"
          data-game="918KISSORI"
          type="button"
        >

          <div class="game-logo-auto orange">

            <span class="default-logo">
              918
            </span>

            <img
              src="images/918kissori.png"
              alt="918KISSORI"
              class="real-game-logo"
            >

          </div>

          <strong>
            918KISSORI
          </strong>

          <small>
            VIEW GAME
          </small>

        </button>


        <!-- 918KISSKAYA -->
        <button
          class="game-card"
          data-game="918KISSKAYA"
          type="button"
        >

          <div class="game-logo-auto blue">

            <span class="default-logo">
              K
            </span>

            <img
              src="images/918kisskaya.png"
              alt="918KISSKAYA"
              class="real-game-logo"
            >

          </div>

          <strong>
            918KISSKAYA
          </strong>

          <small>
            VIEW GAME
          </small>

        </button>


        <!-- NEWTOWN -->
        <button
          class="game-card"
          data-game="NEWTOWN"
          type="button"
        >

          <div class="game-logo-auto orange">

            <span class="default-logo">
              N
            </span>

            <img
              src="images/newtown.png"
              alt="NEWTOWN"
              class="real-game-logo"
            >

          </div>

          <strong>
            NEWTOWN
          </strong>

          <small>
            VIEW GAME
          </small>

        </button>


        <!-- PLAYBOY -->
        <button
          class="game-card"
          data-game="PLAYBOY"
          type="button"
        >

          <div class="game-logo-auto blue">

            <span class="default-logo">
              PB
            </span>

            <img
              src="images/playboy.png"
              alt="PLAYBOY"
              class="real-game-logo"
            >

          </div>

          <strong>
            PLAYBOY
          </strong>

          <small>
            VIEW GAME
          </small>

        </button>


        <!-- SUNCITY -->
        <button
          class="game-card"
          data-game="SUNCITY"
          type="button"
        >

          <div class="game-logo-auto orange">

            <span class="default-logo">
              S
            </span>

            <img
              src="images/suncity.png"
              alt="SUNCITY"
              class="real-game-logo"
            >

          </div>

          <strong>
            SUNCITY
          </strong>

          <small>
            VIEW GAME
          </small>

        </button>


        <!-- GW99 -->
        <button
          class="game-card"
          data-game="GW99"
          type="button"
        >

          <div class="game-logo-auto blue">

            <span class="default-logo">
              GW
            </span>

            <img
              src="images/gw99.png"
              alt="GW99"
              class="real-game-logo"
            >

          </div>

          <strong>
            GW99
          </strong>

          <small>
            VIEW GAME
          </small>

        </button>


        <!-- ROLLEX -->
        <button
          class="game-card"
          data-game="ROLLEX"
          type="button"
        >

          <div class="game-logo-auto orange">

            <span class="default-logo">
              R
            </span>

            <img
              src="images/rollex.png"
              alt="ROLLEX"
              class="real-game-logo"
            >

          </div>

          <strong>
            ROLLEX
          </strong>

          <small>
            VIEW GAME
          </small>

        </button>


      </div>

    </section>


  </main>


  <!-- FOOTER -->
  <footer>

    <div class="footer-brand">

      <img
        src="logo.png"
        alt="MTC196"
      >

      <div>

        <strong>
          MTC<span>196</span>
        </strong>

        <small>
          OFFICIAL
        </small>

      </div>

    </div>


    <div class="footer-line"></div>


    <p>
      OFFICIAL PLATFORM
    </p>


    <small class="copyright">
      © <span id="year"></span> MTC196
    </small>

  </footer>


  <!-- GAME POPUP -->
  <div
    class="popup-overlay"
    id="gamePopup"
  >

    <div class="popup-box">


      <button
        class="popup-close"
        id="popupClose"
        type="button"
        aria-label="Tutup"
      >
        ×
      </button>


      <div class="popup-logo">

        <img
          src="logo.png"
          alt="MTC196"
        >

      </div>


      <small class="popup-label">
        MTC196 OFFICIAL
      </small>


      <h3 id="popupGame">
        Game
      </h3>


      <p>
        Hubungi Customer Service untuk maklumat lanjut.
      </p>


      <div class="popup-buttons">


        <!-- WHATSAPP -->
        <a
          href="https://wa.link/tums26"
          class="popup-button whatsapp-popup"
          target="_blank"
          rel="noopener noreferrer"
        >

          <div class="popup-icon">
            W
          </div>

          <div>

            <small>
              CUSTOMER SERVICE
            </small>

            <strong>
              WhatsApp
            </strong>

          </div>

          <span>
            ›
          </span>

        </a>


        <!-- TELEGRAM -->
        <a
          href="https://t.me/MTC196m"
          class="popup-button telegram-popup"
          target="_blank"
          rel="noopener noreferrer"
        >

          <div class="popup-icon">
            T
          </div>

          <div>

            <small>
              CUSTOMER SERVICE
            </small>

            <strong>
              Telegram
            </strong>

          </div>

          <span>
            ›
          </span>

        </a>


      </div>

    </div>

  </div>


  <script src="script.js"></script>

</body>
</html>
